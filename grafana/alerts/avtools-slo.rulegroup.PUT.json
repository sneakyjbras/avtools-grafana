    {
      "id": 0,
      "uid": "avslosnmpfresh",
      "orgID": 12,
      "folderUID": "beuar1of5bo5cf",
      "ruleGroup": "avtools-slo",
      "title": "AV SLO: SNMP Collection Stale (Critical Tier, No Cycle in 10m)",
      "condition": "Active",
      "data": [
        {
          "refId": "#SnmpStale",
          "queryType": "",
          "relativeTimeRange": {
            "from": 900,
            "to": 0
          },
          "datasourceUid": "afcql1n10tnggc",
          "model": {
            "datasource": {
              "type": "prometheus",
              "uid": "afcql1n10tnggc"
            },
            "editorMode": "code",
            "expr": "absent_over_time(avtools_snmp_devices_targeted{submitter_environment=\"prod\", tier=~\"critical|\"}[10m])",
            "instant": true,
            "range": false,
            "intervalMs": 1000,
            "maxDataPoints": 43200,
            "refId": "#SnmpStale"
          }
        },
        {
          "refId": "Active",
          "queryType": "",
          "relativeTimeRange": {
            "from": 0,
            "to": 0
          },
          "datasourceUid": "__expr__",
          "model": {
            "conditions": [
              {
                "evaluator": {
                  "params": [
                    0
                  ],
                  "type": "gt"
                },
                "operator": {
                  "type": "and"
                },
                "query": {
                  "params": [
                    "C"
                  ]
                },
                "reducer": {
                  "params": [],
                  "type": "last"
                },
                "type": "query"
              }
            ],
            "datasource": {
              "type": "__expr__",
              "uid": "__expr__"
            },
            "expression": "#SnmpStale",
            "intervalMs": 1000,
            "maxDataPoints": 43200,
            "refId": "Active",
            "type": "threshold"
          }
        }
      ],
      "noDataState": "OK",
      "execErrState": "Error",
      "for": "0s",
      "annotations": {
        "__dashboardUid__": "av_rooms_dashboard",
        "__panelId__": "900",
        "description": "- SNMP freshness SLO, critical tier (`*/5`, 8 shards x 16 threads, ~40s measured sweep)\n  No avtools_snmp_devices_targeted sample from the critical tier in 10m (~2 missed 5-min cycles) => critical-metric collection has stalled.\n  The matcher is `tier=~\"critical|\"`, never `tier=\"critical\"`: the empty alternation branch also matches series that carry no `tier` label at all, which is every series until the tiered CronJobs deploy (the app only attaches `tier` when `--priority != all`). A bare equality matcher would select nothing today and `absent_over_time` of nothing is 1, i.e. an instant false page; the empty branch also keeps this rule quiet during a partial rollout in which an untiered `--priority all` job is still publishing.\n  Per-tier scoping is mandatory after the split: with one untiered `absent_over_time` any single surviving tier keeps the series alive and masks every other tier's death.\n  Action: check the snmp-critical CronJob (before the split: snmp-timeseries).",
        "summary": "No critical-tier SNMP collection cycle has completed in the last 10 minutes"
      },
      "labels": {
        "av_alert_type": "slo",
        "severity": "critical",
        "av_alert_family": "slo"
      },
      "isPaused": false,
      "notification_settings": {
        "receiver": "AV Tools",
        "group_by": [
          "alertname",
          "grafana_folder"
        ],
        "group_wait": "30s",
        "group_interval": "168h",
        "repeat_interval": "168h"
      },
      "record": null
    },
